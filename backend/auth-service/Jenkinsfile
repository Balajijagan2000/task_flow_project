pipeline {
    agent any

    environment {
        SERVICE_NAME = "auth-service"
        IMAGE_NAME = "taskflow-auth-service"
        IMAGE_TAG = "v${env.BUILD_NUMBER}"
        NAMESPACE = "taskflow-app"
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Compile & Test Service') {
            steps {
                echo "=== Compiling and Testing ${SERVICE_NAME} only ==="
                dir('backend') {
                    sh 'mvn clean verify -pl auth-service -am -Djava.version=21'
                }
            }
            post {
                always {
                    junit testResults: 'backend/auth-service/target/surefire-reports/*.xml', allowEmptyResults: false
                }
            }
        }

        stage('Build Container Image') {
            steps {
                echo "=== Building Docker Image for ${SERVICE_NAME} ==="
                sh """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest -f backend/auth-service/Dockerfile backend
                """
            }
        }

        stage('Load Image to Cluster') {
            steps {
                echo "=== Loading ${IMAGE_NAME}:${IMAGE_TAG} into local cluster ==="
                sh "kind load docker-image ${IMAGE_NAME}:${IMAGE_TAG} --name taskflow || true"
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "=== Deploying ${SERVICE_NAME} into namespace ${NAMESPACE} ==="
                sh """
                    kubectl apply -f deploy/kubernetes/auth-service/ -n ${NAMESPACE}
                    kubectl set image deployment/auth-service auth-service=${IMAGE_NAME}:${IMAGE_TAG} -n ${NAMESPACE}
                """
            }
        }

        stage('Verify Rollout Status') {
            steps {
                echo "=== Verifying Zero-Downtime Rolling Update for ${SERVICE_NAME} ==="
                sh """
                    kubectl rollout status deployment/auth-service -n ${NAMESPACE} --timeout=120s
                    kubectl get pods -n ${NAMESPACE} -l app=auth-service
                """
            }
        }
    }

    post {
        success {
            echo "SUCCESS: ${SERVICE_NAME} (${IMAGE_TAG}) deployed successfully without impacting other services!"
        }
        failure {
            echo "FAILURE: ${SERVICE_NAME} pipeline failed. Check test reports and container logs."
        }
        always {
            node {
                cleanWs deleteDirs: true, notFailBuild: true
            }
        }
    }
}
