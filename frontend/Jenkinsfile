pipeline {
    agent any

    environment {
        SERVICE_NAME = "frontend"
        IMAGE_NAME = "taskflow-frontend"
        IMAGE_TAG = "v${env.BUILD_NUMBER}"
        NAMESPACE = "taskflow"
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Build Angular SPA') {
            steps {
                echo "=== Compiling Angular Frontend Production Bundle ==="
                dir('frontend') {
                    sh '''
                        npm ci || npm install
                        npm run build -- --configuration production
                    '''
                }
            }
        }

        stage('Build Container Image') {
            steps {
                echo "=== Building Docker Image for ${SERVICE_NAME} ==="
                sh """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest -f frontend/Dockerfile frontend
                """
            }
        }

        stage('Load Image to Cluster') {
            steps {
                echo "=== Loading ${IMAGE_NAME}:${IMAGE_TAG} into local cluster ==="
                sh "kind load docker-image ${IMAGE_NAME}:${IMAGE_TAG} --name taskflow || true"
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "=== Deploying ${SERVICE_NAME} into namespace ${NAMESPACE} ==="
                sh """
                    kubectl apply -f deploy/kubernetes/frontend/ -n ${NAMESPACE}
                    kubectl set image deployment/frontend frontend=${IMAGE_NAME}:${IMAGE_TAG} -n ${NAMESPACE}
                """
            }
        }

        stage('Verify Rollout Status') {
            steps {
                echo "=== Verifying Zero-Downtime Rolling Update for ${SERVICE_NAME} ==="
                sh """
                    kubectl rollout status deployment/frontend -n ${NAMESPACE} --timeout=120s
                    kubectl get pods -n ${NAMESPACE} -l app=frontend
                """
            }
        }
    }

    post {
        success {
            echo "SUCCESS: ${SERVICE_NAME} (${IMAGE_TAG}) deployed successfully without impacting other services!"
        }
        failure {
            echo "FAILURE: ${SERVICE_NAME} pipeline failed. Check frontend build output and container logs."
        }
        always {
            cleanWs deleteDirs: true, notFailBuild: true
        }
    }
}
