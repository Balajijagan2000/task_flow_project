pipeline {
    agent any

    environment {
        // Build & image tagging configuration
        APP_VERSION = "1.0.0"
        IMAGE_TAG = "v${env.BUILD_NUMBER}"
        NAMESPACE = "taskflow"
        
        // Java & Node version declarations
        JAVA_HOME = tool name: 'Java-21', type: 'jdk'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Environment Check') {
            steps {
                echo "=== Checking Toolchain Versions ==="
                sh '''
                    java -version
                    mvn -version
                    node -v || true
                    docker --version || true
                    kubectl version --client || true
                '''
            }
        }

        stage('Backend Build & Automated Tests') {
            steps {
                echo "=== Compiling and Running Backend Test Suites (Java 21) ==="
                dir('backend') {
                    sh 'mvn clean verify -Djava.version=21'
                }
            }
            post {
                always {
                    // Collect and visualize JUnit test reports in Jenkins UI
                    junit testResults: 'backend/**/target/surefire-reports/*.xml', allowEmptyResults: false
                }
            }
        }

        stage('Frontend Build') {
            steps {
                echo "=== Building Angular Single Page Application ==="
                dir('frontend') {
                    sh '''
                        npm ci
                        npm run build -- --configuration production
                    '''
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                echo "=== Building Multi-Stage Container Images ==="
                sh """
                    docker build -t taskflow-auth-service:${IMAGE_TAG} -t taskflow-auth-service:latest -f backend/auth-service/Dockerfile backend
                    docker build -t taskflow-task-service:${IMAGE_TAG} -t taskflow-task-service:latest -f backend/task-service/Dockerfile backend
                    docker build -t taskflow-stats-service:${IMAGE_TAG} -t taskflow-stats-service:latest -f backend/stats-service/Dockerfile backend
                    docker build -t taskflow-frontend:${IMAGE_TAG} -t taskflow-frontend:latest -f frontend/Dockerfile frontend
                """
            }
        }

        stage('Load Images to Local Kubernetes') {
            steps {
                echo "=== Loading Images into Local kind Cluster ==="
                // If using kind cluster: load images directly without external registry
                sh """
                    kind load docker-image taskflow-auth-service:${IMAGE_TAG} --name taskflow || true
                    kind load docker-image taskflow-task-service:${IMAGE_TAG} --name taskflow || true
                    kind load docker-image taskflow-stats-service:${IMAGE_TAG} --name taskflow || true
                    kind load docker-image taskflow-frontend:${IMAGE_TAG} --name taskflow || true
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "=== Applying Kubernetes Manifests & Rolling Out ==="
                sh """
                    kubectl apply -k deploy/kubernetes
                    
                    # Update deployment images to the newly built tag
                    kubectl set image deployment/auth-service auth-service=taskflow-auth-service:${IMAGE_TAG} -n ${NAMESPACE}
                    kubectl set image deployment/task-service task-service=taskflow-task-service:${IMAGE_TAG} -n ${NAMESPACE}
                    kubectl set image deployment/stats-service stats-service=taskflow-stats-service:${IMAGE_TAG} -n ${NAMESPACE}
                    kubectl set image deployment/frontend frontend=taskflow-frontend:${IMAGE_TAG} -n ${NAMESPACE}
                """
            }
        }

        stage('Verify Rollout Status') {
            steps {
                echo "=== Verifying Zero-Downtime Rolling Update ==="
                sh """
                    kubectl rollout status deployment/auth-service -n ${NAMESPACE} --timeout=120s
                    kubectl rollout status deployment/task-service -n ${NAMESPACE} --timeout=120s
                    kubectl rollout status deployment/stats-service -n ${NAMESPACE} --timeout=120s
                    kubectl rollout status deployment/frontend -n ${NAMESPACE} --timeout=120s
                    
                    kubectl get pods -n ${NAMESPACE} -l app.kubernetes.io/part-of=taskflow-application
                """
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Pipeline completed and TaskFlow was successfully deployed to Kubernetes!"
        }
        failure {
            echo "FAILURE: TaskFlow pipeline failed. Inspect surefire reports and container logs above."
        }
        always {
            cleanWs deleteDirs: true, notFailBuild: true
        }
    }
}
