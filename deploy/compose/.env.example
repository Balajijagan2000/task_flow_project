# TaskFlow Docker Compose Environment Variables
# Copy this file to .env before starting: cp .env.example .env

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_PORT=5432

# Spring Profile
SPRING_PROFILES_ACTIVE=localserver

# JWT Secret Key (HMAC SHA-256 requires >= 32 characters)
JWT_SECRET=taskflow-super-secret-key-for-local-compose-32chars!

# Port Mappings
AUTH_SERVICE_PORT=8081
TASK_SERVICE_PORT=8082
STATS_SERVICE_PORT=8083
FRONTEND_PORT=4200
